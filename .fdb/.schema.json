{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fact Frontmatter",
  "description": "Schema for the YAML frontmatter of a fact file.",
  "type": "object",
  "required": ["status", "created", "created-by"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "description": "Lifecycle status of the fact."
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Free-form categorisation tags."
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Creation date in YYYY-MM-DD format."
    },
    "created-by": {
      "type": "string",
      "minLength": 1,
      "description": "Author identifier."
    },
    "reviewed-by": {
      "type": "string",
      "description": "Reviewer identifier; empty string means unreviewed."
    },
    "parent": {
      "type": "string",
      "description": "Parent fact slug; empty string means root fact."
    },
    "last-edited-by": {
      "type": "string"
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "due": {
      "type": "string"
    },
    "defer-until": {
      "type": "string"
    },
    "done-at": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": ["high", "normal", "low"]
    },
    "branch": {
      "type": "string",
      "description": "Git branch a deferred todo belongs to; only valid on todo facts."
    },
    "milestone": {
      "type": "string",
      "description": "Milestone (planning fact slug) grouping deferred todos; only valid on todo facts."
    },
    "reason": {
      "type": "string",
      "description": "Why deferred work was not done now; only valid on todo facts."
    },
    "when": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "recurrence": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "auto-create-todo": {
      "type": "boolean"
    },
    "participants": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Quality-contract participant aliases mapped to repository or application locators."
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Capability vocabulary for a quality contract."
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      },
      "description": "Named complete capability sets for a quality contract."
    }
  }
}